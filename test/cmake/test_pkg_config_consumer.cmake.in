set(prefix "@CMAKE_CURRENT_BINARY_DIR@/consumer-install/pkgconfig")
set(build_dir "@CMAKE_CURRENT_BINARY_DIR@/consumer-build/pkgconfig")
set(exe "${build_dir}/ruckig_c_pkg_config_consumer@CMAKE_EXECUTABLE_SUFFIX@")

file(REMOVE_RECURSE "${prefix}" "${build_dir}")
file(MAKE_DIRECTORY "${build_dir}")

execute_process(
  COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_BINARY_DIR@" --prefix "${prefix}"
  RESULT_VARIABLE install_result
)
if(NOT install_result EQUAL 0)
  message(FATAL_ERROR "pkg-config consumer install failed")
endif()

set(ENV{PKG_CONFIG_PATH} "${prefix}/@CMAKE_INSTALL_LIBDIR@/pkgconfig")
execute_process(
  COMMAND "@PKG_CONFIG_EXECUTABLE@" --cflags ruckig_c
  OUTPUT_VARIABLE pkg_cflags
  OUTPUT_STRIP_TRAILING_WHITESPACE
  RESULT_VARIABLE pkg_cflags_result
)
if(NOT pkg_cflags_result EQUAL 0)
  message(FATAL_ERROR "pkg-config cflags lookup failed")
endif()

execute_process(
  COMMAND "@PKG_CONFIG_EXECUTABLE@" --static --libs ruckig_c
  OUTPUT_VARIABLE pkg_libs
  OUTPUT_STRIP_TRAILING_WHITESPACE
  RESULT_VARIABLE pkg_libs_result
)
if(NOT pkg_libs_result EQUAL 0)
  message(FATAL_ERROR "pkg-config libs lookup failed")
endif()

separate_arguments(pkg_cflags UNIX_COMMAND "${pkg_cflags}")
separate_arguments(pkg_libs UNIX_COMMAND "${pkg_libs}")
execute_process(
  COMMAND "@CMAKE_C_COMPILER@" -std=c99 ${pkg_cflags} "@CMAKE_CURRENT_SOURCE_DIR@/test/consumer/pkg_config/main.c" -o "${exe}" ${pkg_libs}
  RESULT_VARIABLE compile_result
)
if(NOT compile_result EQUAL 0)
  message(FATAL_ERROR "pkg-config consumer compile failed")
endif()

execute_process(
  COMMAND "${exe}"
  RESULT_VARIABLE run_result
)
if(NOT run_result EQUAL 0)
  message(FATAL_ERROR "pkg-config consumer run failed")
endif()
