set(prefix "@CMAKE_CURRENT_BINARY_DIR@/consumer-install/cmake")
set(build_dir "@CMAKE_CURRENT_BINARY_DIR@/consumer-build/cmake")
set(exe "${build_dir}/ruckig_c_consumer@CMAKE_EXECUTABLE_SUFFIX@")
set(generator_args -G "@CMAKE_GENERATOR@")
if("@CMAKE_MAKE_PROGRAM@" STREQUAL "")
  set(make_program_args "")
else()
  set(make_program_args "-DCMAKE_MAKE_PROGRAM=@CMAKE_MAKE_PROGRAM@")
endif()

set(consumer_c_flags "")
set(consumer_exe_linker_flags "")
if("@CMAKE_C_COMPILER_ID@" MATCHES "Clang|GNU")
  set(consumer_sanitizers "")
  if("@RUCKIG_C_ENABLE_ASAN@" STREQUAL "ON")
    list(APPEND consumer_sanitizers address)
  endif()
  if("@RUCKIG_C_ENABLE_UBSAN@" STREQUAL "ON")
    list(APPEND consumer_sanitizers undefined)
  endif()
  if(consumer_sanitizers)
    list(JOIN consumer_sanitizers "," consumer_sanitizer_flags)
    set(consumer_c_flags "-fsanitize=${consumer_sanitizer_flags} -fno-omit-frame-pointer")
    set(consumer_exe_linker_flags "-fsanitize=${consumer_sanitizer_flags}")
  endif()
  if("@RUCKIG_C_ENABLE_COVERAGE@" STREQUAL "ON")
    string(APPEND consumer_c_flags " -fprofile-instr-generate -fcoverage-mapping")
    string(APPEND consumer_exe_linker_flags " -fprofile-instr-generate -fcoverage-mapping")
  endif()
endif()

file(REMOVE_RECURSE "${prefix}" "${build_dir}")
execute_process(
  COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_BINARY_DIR@" --prefix "${prefix}"
  RESULT_VARIABLE install_result
)
if(NOT install_result EQUAL 0)
  message(FATAL_ERROR "cmake consumer install failed")
endif()

execute_process(
  COMMAND
    "@CMAKE_COMMAND@"
    -S "@CMAKE_CURRENT_SOURCE_DIR@/test/consumer/cmake"
    -B "${build_dir}"
    ${generator_args}
    ${make_program_args}
    "-DCMAKE_C_COMPILER=@CMAKE_C_COMPILER@"
    "-DCMAKE_BUILD_TYPE=@CMAKE_BUILD_TYPE@"
    "-DCMAKE_C_FLAGS=${consumer_c_flags}"
    "-DCMAKE_EXE_LINKER_FLAGS=${consumer_exe_linker_flags}"
    -DCMAKE_PREFIX_PATH=${prefix}
  RESULT_VARIABLE configure_result
)
if(NOT configure_result EQUAL 0)
  message(FATAL_ERROR "cmake consumer configure failed")
endif()

execute_process(
  COMMAND "@CMAKE_COMMAND@" --build "${build_dir}"
  RESULT_VARIABLE build_result
)
if(NOT build_result EQUAL 0)
  message(FATAL_ERROR "cmake consumer build failed")
endif()

if(NOT EXISTS "${exe}")
  set(exe_debug "${build_dir}/Debug/ruckig_c_consumer@CMAKE_EXECUTABLE_SUFFIX@")
  set(exe_release "${build_dir}/Release/ruckig_c_consumer@CMAKE_EXECUTABLE_SUFFIX@")
  if(EXISTS "${exe_debug}")
    set(exe "${exe_debug}")
  elseif(EXISTS "${exe_release}")
    set(exe "${exe_release}")
  endif()
endif()

execute_process(
  COMMAND "${exe}"
  RESULT_VARIABLE run_result
)
if(NOT run_result EQUAL 0)
  message(FATAL_ERROR "cmake consumer run failed")
endif()
