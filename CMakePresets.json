{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Developer default",
      "description": "Generic local build under out/build/dev. Requires the current shell to provide a C/C++ compiler.",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "BUILD_RUCKIG_C": "ON",
        "BUILD_RUCKIG_C_TESTS": "ON",
        "BUILD_RUCKIG_C_EXAMPLES": "ON",
        "BUILD_RUCKIG_C_ORACLE_TESTS": "OFF",
        "BUILD_RUCKIG_C_PERFORMANCE_TESTS": "OFF"
      }
    },
    {
      "name": "windows-clang-ninja",
      "displayName": "Windows LLVM clang + Ninja",
      "description": "Windows local build under out/build/windows-clang-ninja using the verified LLVM clang toolchain and Visual Studio bundled Ninja.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MAKE_PROGRAM": "C:/Program Files/Microsoft Visual Studio/2022/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe",
        "CMAKE_C_COMPILER": "D:/Program Files/LLVM/bin/clang.exe",
        "CMAKE_CXX_COMPILER": "D:/Program Files/LLVM/bin/clang++.exe",
        "BUILD_RUCKIG_C": "ON",
        "BUILD_RUCKIG_C_TESTS": "ON",
        "BUILD_RUCKIG_C_EXAMPLES": "ON",
        "BUILD_RUCKIG_C_ORACLE_TESTS": "OFF",
        "BUILD_RUCKIG_C_PERFORMANCE_TESTS": "OFF"
      }
    },
    {
      "name": "windows-clang-ninja-shared",
      "displayName": "Windows LLVM clang + Ninja shared library",
      "description": "Windows shared-library build under out/build/windows-clang-ninja-shared using the verified LLVM clang toolchain and Visual Studio bundled Ninja.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MAKE_PROGRAM": "C:/Program Files/Microsoft Visual Studio/2022/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe",
        "CMAKE_C_COMPILER": "D:/Program Files/LLVM/bin/clang.exe",
        "CMAKE_CXX_COMPILER": "D:/Program Files/LLVM/bin/clang++.exe",
        "BUILD_SHARED_LIBS": "ON",
        "BUILD_RUCKIG_C": "ON",
        "BUILD_RUCKIG_C_TESTS": "ON",
        "BUILD_RUCKIG_C_EXAMPLES": "ON",
        "BUILD_RUCKIG_C_ORACLE_TESTS": "OFF",
        "BUILD_RUCKIG_C_PERFORMANCE_TESTS": "OFF"
      }
    },
    {
      "name": "windows-clang-ninja-oracle",
      "displayName": "Windows LLVM clang + Ninja oracle tests",
      "description": "Windows oracle differential build under out/build/windows-clang-ninja-oracle using the verified LLVM clang toolchain.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MAKE_PROGRAM": "C:/Program Files/Microsoft Visual Studio/2022/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe",
        "CMAKE_C_COMPILER": "D:/Program Files/LLVM/bin/clang.exe",
        "CMAKE_CXX_COMPILER": "D:/Program Files/LLVM/bin/clang++.exe",
        "BUILD_RUCKIG_C": "ON",
        "BUILD_RUCKIG_C_TESTS": "ON",
        "BUILD_RUCKIG_C_EXAMPLES": "ON",
        "BUILD_RUCKIG_C_ORACLE_TESTS": "ON",
        "BUILD_RUCKIG_C_PERFORMANCE_TESTS": "OFF"
      }
    },
    {
      "name": "windows-clang-ninja-performance",
      "displayName": "Windows LLVM clang + Ninja performance benchmark",
      "description": "Windows performance benchmark build under out/build/windows-clang-ninja-performance using the verified LLVM clang toolchain.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MAKE_PROGRAM": "C:/Program Files/Microsoft Visual Studio/2022/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe",
        "CMAKE_C_COMPILER": "D:/Program Files/LLVM/bin/clang.exe",
        "CMAKE_CXX_COMPILER": "D:/Program Files/LLVM/bin/clang++.exe",
        "BUILD_RUCKIG_C": "ON",
        "BUILD_RUCKIG_C_TESTS": "OFF",
        "BUILD_RUCKIG_C_EXAMPLES": "OFF",
        "BUILD_RUCKIG_C_ORACLE_TESTS": "OFF",
        "BUILD_RUCKIG_C_PERFORMANCE_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Release build under out/build/release.",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_RUCKIG_C": "ON",
        "BUILD_RUCKIG_C_TESTS": "ON",
        "BUILD_RUCKIG_C_EXAMPLES": "ON",
        "BUILD_RUCKIG_C_ORACLE_TESTS": "OFF",
        "BUILD_RUCKIG_C_PERFORMANCE_TESTS": "OFF"
      }
    },
    {
      "name": "shared",
      "displayName": "Shared library",
      "description": "Shared-library build under out/build/shared.",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_SHARED_LIBS": "ON",
        "BUILD_RUCKIG_C": "ON",
        "BUILD_RUCKIG_C_TESTS": "ON",
        "BUILD_RUCKIG_C_EXAMPLES": "ON",
        "BUILD_RUCKIG_C_ORACLE_TESTS": "OFF",
        "BUILD_RUCKIG_C_PERFORMANCE_TESTS": "OFF"
      }
    },
    {
      "name": "oracle",
      "displayName": "Oracle tests",
      "description": "Oracle differential test build under out/build/oracle.",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_RUCKIG_C": "ON",
        "BUILD_RUCKIG_C_TESTS": "ON",
        "BUILD_RUCKIG_C_EXAMPLES": "ON",
        "BUILD_RUCKIG_C_ORACLE_TESTS": "ON",
        "BUILD_RUCKIG_C_PERFORMANCE_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "windows-clang-ninja",
      "configurePreset": "windows-clang-ninja",
      "configuration": "Release"
    },
    {
      "name": "windows-clang-ninja-shared",
      "configurePreset": "windows-clang-ninja-shared",
      "configuration": "Release"
    },
    {
      "name": "windows-clang-ninja-oracle",
      "configurePreset": "windows-clang-ninja-oracle",
      "configuration": "Release"
    },
    {
      "name": "windows-clang-ninja-performance",
      "configurePreset": "windows-clang-ninja-performance",
      "configuration": "Release"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "shared",
      "configurePreset": "shared",
      "configuration": "Release"
    },
    {
      "name": "oracle",
      "configurePreset": "oracle",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-clang-ninja",
      "configurePreset": "windows-clang-ninja",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-clang-ninja-shared",
      "configurePreset": "windows-clang-ninja-shared",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-clang-ninja-oracle",
      "configurePreset": "windows-clang-ninja-oracle",
      "configuration": "Release",
      "filter": {
        "exclude": {
          "name": "ruckig_c_oracle_random_release"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-clang-ninja-performance",
      "configurePreset": "windows-clang-ninja-performance",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "shared",
      "configurePreset": "shared",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "oracle",
      "configurePreset": "oracle",
      "configuration": "Release",
      "filter": {
        "exclude": {
          "name": "ruckig_c_oracle_random_release"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
